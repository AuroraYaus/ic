# 跨平台行尾统一（2026-09-08）：仓库在 Windows + Ubuntu 双环境开发，
# 一切文本文件以 LF 提交并以 LF 检出——Windows 的 autocrlf 转换与
# "LF will be replaced by CRLF" 警告由此消除（规则见 CLAUDE.md §13）
* text=auto

# 知识库文本资产一律 LF
*.md        text eol=lf
*.markdown  text eol=lf
*.mmd       text eol=lf
*.svg       text eol=lf
*.html      text eol=lf
*.json      text eol=lf

# 脚本与源码一律 LF
*.sh        text eol=lf
*.bash      text eol=lf
*.tcl       text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.v         text eol=lf
*.sv        text eol=lf
Makefile    text eol=lf

# 配置文件
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制资产不做行尾处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
